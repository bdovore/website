        <script>
        // Fermer le menu si clic en dehors
        $(document).click(function(e) {
            if (!$(e.target).closest('#tri-toggle').length && !$(e.target).closest('#tri-menu').length) {
                $('#tri-menu').hide();
                $('#tri-toggle').removeClass('active');
            }
        });
        
        // Fonction pour afficher/masquer le menu de tri
        function toggleTriMenu() {
            var menu = $('#tri-menu');
            var toggle = $('#tri-toggle');
            
            if (menu.is(':visible')) {
                menu.hide();
                toggle.removeClass('active');
            } else {
                menu.show();
                toggle.addClass('active');
            }
            
            // Empêcher la propagation du clic
            event.stopPropagation();
        }
        
        // Fonction pour définir le tri et soumettre le formulaire
        function setGridSort(value) {
            $('input[name="grid_sort"]').val(value);
            $('#f_collection').submit();
        }
        </script>
        
