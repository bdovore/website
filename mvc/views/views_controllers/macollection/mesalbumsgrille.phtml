<script language ='javascript'>
    var uri = "./mesetageres?view=grid&";
    q = param();
    for (k in q) {
        if (k.substring(0, 4) != "sort" && k.substring(0, 5) != "order") {
        uri += k + "=" + encodeURIComponent(q[k][0]) + "&";
        }
    }

    function toggleFilters() {
        const filterHeader = document.querySelector('.filter-header');
        const filterContent = document.querySelector('.filter-content');
        const filterStateInput = document.getElementById('filter_state');
        const isCollapsed = filterHeader.classList.contains('collapsed');
        
        filterHeader.classList.toggle('collapsed');
        filterContent.classList.toggle('collapsed');
        
        const newState = isCollapsed ? 'open' : 'closed';
        filterStateInput.value = newState;
        
        updateURLParam('filters', newState);
    }
    
    function updateURLParam(key, value) {
        const url = new URL(window.location.href);
        const params = new URLSearchParams(url.search);
        
        if (value) {
            params.set(key, value);
        } else {
            params.delete(key);
        }
        
        window.history.replaceState({}, '', url.pathname + '?' + params.toString());
    }
    
    function getURLParam(key) {
        const url = new URL(window.location.href);
        const params = new URLSearchParams(url.search);
        return params.get(key);
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        const filterHeader = document.querySelector('.filter-header');
        const filterContent = document.querySelector('.filter-content');
        
        if (filterHeader && filterContent) {
            const filterState = getURLParam('filters');
            const shouldBeOpen = filterState === 'open';
            
            if (!shouldBeOpen) {
                filterHeader.classList.add('collapsed');
                filterContent.classList.add('collapsed');
            }
        }
    });
</script>

