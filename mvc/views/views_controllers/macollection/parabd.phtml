<?php $h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); }; $page = $view->getHelper('pagination'); $conditions = array('MINT'=>'Neuf','NEAR_MINT'=>'Comme neuf','VERY_GOOD'=>'Très bon état','GOOD'=>'Bon état','FAIR'=>'État correct','POOR'=>'Usé'); ?>
<div class="cadre1 parabd-page">
    <?php echo $page->menuCollection(); ?>
    <div class="parabd-heading"><h1>Ma collection Para-BD</h1><a class="button" href="<?php echo BDO_URL; ?>parabd/create">Créer un objet</a></div>
    <?php if ($view->created_item_id) { ?><p class="parabd-success">L’objet a bien été créé et ajouté à cette liste. <a href="<?php echo BDO_URL; ?>parabd/fiche?id=<?php echo intval($view->created_item_id); ?>">Voir sa fiche</a>.</p><?php } ?>
    <nav class="parabd-lists"><a<?php if ($view->state === 'OWNED') echo ' class="active"'; ?> href="?list=owned">Ma collection</a><a<?php if ($view->state === 'WISHLIST') echo ' class="active"'; ?> href="?list=wishlist">Mes envies</a></nav>
    <div class="parabd-grid"><?php foreach ($view->copies as $copy) { ?><article class="parabd-card<?php if (intval($copy['ITEM_ID']) === intval($view->created_item_id)) echo ' newly-created'; ?>">
        <?php if ($copy['PRIMARY_IMAGE']) { ?><img src="<?php echo $h(BDO_URL_PARABD . $copy['PRIMARY_IMAGE']); ?>" alt=""><?php } ?><div><small><?php echo $h($copy['SUBTYPE_LABEL'] ?: $copy['TYPE_LABEL']); ?></small><?php if ($copy['PRIMARY_IMAGE_IS_EXPLICIT']) { ?><p><span class="parabd-explicit-badge">Visuel explicite</span><?php if (!$view->explicit_allowed) { ?> <small>Image floutée</small><?php } ?></p><?php } ?><h2><a href="<?php echo BDO_URL; ?>parabd/fiche?id=<?php echo intval($copy['ITEM_ID']); ?>"><?php echo $h($copy['TITLE']); ?></a></h2>
        <?php if (intval($copy['QUANTITY']) > 1) { ?><p>Quantité : <?php echo intval($copy['QUANTITY']); ?></p><?php } ?>
        <?php if ($copy['COPY_NUMBER']) { ?><p>Exemplaire n° <?php echo $h($copy['COPY_NUMBER']); ?></p><?php } ?>
        <?php if (isset($conditions[$copy['CONDITION_CODE']])) { ?><p><?php echo $conditions[$copy['CONDITION_CODE']]; ?></p><?php } ?>
        <?php if ($copy['PURCHASE_DATE']) { ?><p>Acheté le <?php echo $h(date('d/m/Y', strtotime($copy['PURCHASE_DATE']))); ?></p><?php } ?>
        <?php if ($copy['COPY_IS_SIGNED']) { ?><span class="parabd-copy-badge">Signé</span><?php } ?> <?php if ($copy['COPY_IS_DEDICATED']) { ?><span class="parabd-copy-badge">Dédicacé</span><?php } ?> <?php if ($copy['IS_GIFT']) { ?><span class="parabd-copy-badge">Cadeau</span><?php } ?>
        <?php if ($copy['PRICE'] !== null) { ?><p>Prix d’achat : <?php echo $h($copy['PRICE'] . ' ' . $copy['CURRENCY']); ?> <small><?php echo $copy['IS_PRICE_PUBLIC'] ? 'visible sur ma page publique' : 'privé'; ?></small></p><?php } ?>
        <form class="parabd-json-form" action="<?php echo BDO_URL; ?>parabd/removecopy" method="post" data-confirm="Retirer cet exemplaire ?"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="copy_id" value="<?php echo intval($copy['ID_COPY']); ?>"><button type="submit">Retirer</button></form></div>
    </article><?php } ?></div><?php if (!$view->copies) { ?><p>Cette liste est vide.</p><?php } ?>
</div>
<script src="<?php echo BDO_URL; ?>script/parabd.js?v=20260809b" type="text/javascript"></script>
