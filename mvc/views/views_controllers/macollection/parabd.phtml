<?php $h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); }; $page = $view->getHelper('pagination'); $conditions = array('MINT'=>'Neuf','NEAR_MINT'=>'Comme neuf','VERY_GOOD'=>'Très bon état','GOOD'=>'Bon état','FAIR'=>'État correct','POOR'=>'Usé'); ?>
<div class="cadre1 parabd-page">
    <?php echo $page->menuCollection(); ?>
    <div class="parabd-heading"><h1>Ma collection Para-BD</h1><a class="button" href="<?php echo BDO_URL; ?>parabd/create">Créer un objet</a></div>
    <?php if ($view->created_item_id) { ?><p class="parabd-success">L’objet a bien été créé et ajouté à cette liste. <a href="<?php echo BDO_URL; ?>parabd/fiche?id=<?php echo intval($view->created_item_id); ?>">Voir sa fiche</a>.</p><?php } ?>
    <nav class="parabd-lists"><a<?php if ($view->state === 'OWNED') echo ' class="active"'; ?> href="?list=owned">Ma collection</a><a<?php if ($view->state === 'WISHLIST') echo ' class="active"'; ?> href="?list=wishlist">Mes envies</a></nav>
    <div class="parabd-grid"><?php foreach ($view->copies as $copy) { ?><article class="parabd-card<?php if (intval($copy['ITEM_ID']) === intval($view->created_item_id)) echo ' newly-created'; ?>">
        <?php if ($copy['PRIMARY_IMAGE']) { ?><img src="<?php echo $h(BDO_URL_PARABD . $copy['PRIMARY_IMAGE']); ?>" alt=""><?php } ?><div class="parabd-card-content"><small><?php echo $h($copy['SUBTYPE_LABEL'] ?: $copy['TYPE_LABEL']); ?></small><?php if ($copy['PRIMARY_IMAGE_IS_EXPLICIT']) { ?><p><span class="parabd-explicit-badge">Visuel explicite</span><?php if (!$view->explicit_allowed) { ?> <small>Image floutée</small><?php } ?></p><?php } ?><h2><a href="<?php echo BDO_URL; ?>parabd/fiche?id=<?php echo intval($copy['ITEM_ID']); ?>"><?php echo $h($copy['TITLE']); ?></a><?php if ($view->can_admin) { ?> · <a href="<?php echo BDO_URL; ?>adminparabd/edit?id=<?php echo intval($copy['ITEM_ID']); ?>" title="Modifier la fiche commune"><img class="parabd-admin-edit-icon" src="<?php echo BDO_URL_IMAGE; ?>/edit.gif" alt="Modifier"></a><?php } ?></h2>
        <?php if (intval($copy['QUANTITY']) > 1) { ?><p>Quantité : <?php echo intval($copy['QUANTITY']); ?></p><?php } ?>
        <?php if ($copy['COPY_NUMBER']) { ?><p>Exemplaire n° <?php echo $h($copy['COPY_NUMBER']); ?></p><?php } ?>
        <?php if (isset($conditions[$copy['CONDITION_CODE']])) { ?><p><?php echo $conditions[$copy['CONDITION_CODE']]; ?></p><?php } ?>
        <?php if ($copy['PURCHASE_DATE']) { ?><p>Acheté le <?php echo $h(date('d/m/Y', strtotime($copy['PURCHASE_DATE']))); ?></p><?php } ?>
        <?php if ($copy['COPY_IS_SIGNED']) { ?><span class="parabd-copy-badge">Signé</span><?php } ?> <?php if ($copy['COPY_IS_DEDICATED']) { ?><span class="parabd-copy-badge">Dédicacé</span><?php } ?> <?php if ($copy['IS_GIFT']) { ?><span class="parabd-copy-badge">Cadeau</span><?php } ?>
        <?php if ($copy['PRICE'] !== null) { ?><p>Prix d’achat : <?php echo $h($copy['PRICE'] . ' ' . $copy['CURRENCY']); ?> <small>privé</small></p><?php } ?></div>
        <div class="collection-status collection-status-<?php echo $copy['STATE'] === 'WISHLIST' ? 'wishlist' : 'owned'; ?> parabd-collection-actions parabd-status-actions" data-csrf-token="<?php echo $h($view->csrf_token); ?>" data-item-id="<?php echo intval($copy['ITEM_ID']); ?>">
            <span class="collection-status-badge"><span class="<?php echo $copy['STATE'] === 'WISHLIST' ? 'far fa-heart' : 'fas fa-check'; ?>" aria-hidden="true"></span><?php echo $copy['STATE'] === 'WISHLIST' ? 'Dans ma wishlist' : 'Dans ma collection'; ?></span>
            <?php if ($copy['STATE'] === 'WISHLIST') { ?><div class="button-simple"><a href="#" class="parabd-quick-copy" data-url="<?php echo BDO_URL; ?>parabd/savecopy" data-state="OWNED" data-copy-id="<?php echo intval($copy['ID_COPY']); ?>" title="Ajouter cet objet dans votre collection"><span class="fas fa-check fa-border button-collection" aria-hidden="true"></span><span class="for-big-screen">J'ai</span></a></div><?php } ?>
            <div class="button-simple"><a href="#" class="parabd-quick-copy parabd-delete-copy" data-url="<?php echo BDO_URL; ?>parabd/removecopy" data-action="remove" data-copy-id="<?php echo intval($copy['ID_COPY']); ?>" data-confirm="Retirer cet objet de votre <?php echo $copy['STATE'] === 'WISHLIST' ? 'wishlist' : 'collection'; ?> ?" title="Retirer cet objet de votre <?php echo $copy['STATE'] === 'WISHLIST' ? 'wishlist' : 'collection'; ?>" aria-label="Retirer cet objet de votre <?php echo $copy['STATE'] === 'WISHLIST' ? 'wishlist' : 'collection'; ?>"><span class="far fa-trash-alt fa-border button-collection" aria-hidden="true"></span><span class="for-big-screen">Retirer</span></a></div>
            <span class="parabd-quick-status" aria-live="polite"></span>
        </div>
    </article><?php } ?></div><?php if (!$view->copies) { ?><p>Cette liste est vide.</p><?php } ?>
</div>
