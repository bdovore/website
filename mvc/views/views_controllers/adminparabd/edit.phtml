ton></form></article><?php } ?>
        </section>
        <details class="parabd-admin-history" id="historique"><summary class="parabd-admin-history-toggle"><strong>Historique complet (<?php echo count($view->history); ?>)</strong><span class="fas parabd-history-chevron" aria-hidden="true"></span></summary><div class="parabd-admin-history-content"><?php if (!$view->history) { ?><p>Aucune entrée d’historique.</p><?php } foreach ($view->history as $revision) { ?><article><div class="parabd-history-summary"><div><strong>#<?php echo intval($revision['ID_REVISION']); ?> · <?php echo $h($revision['CHANGE_KIND']); ?></strong><br><small><?php echo $h(date('d/m/Y H:i', strtotime($revision['CREATED_AT']))); ?> par <?php echo $h($revision['AUTHOR_NAME'] ?: 'Utilisateur #' . $revision['AUTHOR_ID']); ?></small></div><span class="parabd-status parabd-status-<?php echo strtolower($revision['STATUS']); ?>"><?php echo $h($revision['STATUS']); ?></span></div><p>Révision de base : <?php echo intval($revision['BASE_REVISION_NO']); ?><?php if ($revision['VALIDATOR_NAME']) echo ' · validée par ' . $h($revision['VALIDATOR_NAME']); ?><?php if ($revision['CONFIRMS'] || $revision['CONTESTS']) echo ' · ' . intval($revision['CONFIRMS']) . ' confirmation(s), ' . intval($revision['CONTESTS']) . ' contestation(s)'; ?></p><details><summary>Afficher le détail enregistré</summary><?php if ($revision['PATCH_BEFORE']) { ?><h3>Avant</h3><pre><?php echo $h($jsonPretty($revision['PATCH_BEFORE'])); ?></pre><?php } ?><h3>Après</h3><pre><?php echo $h($jsonPretty($revision['PATCH_AFTER'])); ?></pre></details></article><?php } ?></div></details>
        <details class="parabd-discussion" id="discussion"><summary><strong>Discussion (<?php echo intval($view->discussion['comment_count']); ?> commentaire(s))</strong><span class="fas parabd-discussion-chevron" aria-hidden="true"></span></summary><div class="parabd-discussion-content">
            <?php if (!$view->discussion['entries']) { ?><p>Aucun échange pour le moment.</p><?php } ?>
            <?php foreach ($view->discussion['entries'] as $entry) { ?><article class="parabd-discussion-entry<?php if ($entry['DISCUSSION_STATUS'] === 'HIDDEN') echo ' is-hidden'; ?>"<?php if ($entry['REVISION_ID']) { ?> data-revision-id="<?php echo intval($entry['REVISION_ID']); ?>"<?php } ?>>
                <?php if ($entry['DISCUSSION_STATUS'] === 'HIDDEN') { ?><p><em>Commentaire masqué par <?php echo $h($entry['HIDDEN_BY_NAME'] ?: 'un administrateur supprimé'); ?> le <?php echo $h(date('d/m/Y H:i', strtotime($entry['HIDDEN_AT']))); ?>.</em></p>
                <?php } elseif ($entry['MESSAGE_TYPE'] === 'PROPOSAL') { ?><div class="parabd-history-summary"><strong><?php echo $h($entry['AUTHOR_NAME'] ?: 'Un membre supprimé'); ?> a proposé une modification</strong><span class="parabd-status parabd-status-<?php echo strtolower($entry['REVISION_STATUS']); ?>"><?php echo $h($entry['REVISION_STATUS'] === 'APPLIED' ? 'APPLIQUÉE AUTOMATIQUEMENT' : $entry['REVISION_STATUS']); ?></span></div><p><small><?php echo $h($jsonPretty($entry['PATCH_BEFORE'])); ?> → <?php echo $h($jsonPretty($entry['PATCH_AFTER'])); ?></small></p><p><?php if ($entry['REVISION_STATUS'] !== 'APPLIED') { ?><?php echo intval($entry['CONFIRMS']); ?>/2 confirmation(s)<?php if ($entry['CONTESTS']) echo ' · ' . intval($entry['CONTESTS']) . ' opposition(s)'; ?> · <?php } ?><button type="button" class="parabd-comment-revision" data-revision-id="<?php echo intval($entry['REVISION_ID']); ?>">Commenter</button></p>
                <?php } else { ?><div class="parabd-history-summary"><strong><?php echo $h($entry['AUTHOR_NAME'] ?: 'Membre supprimé'); ?></strong><small><?php echo $h(date('d/m/Y H:i', strtotime($entry['CREATED_AT']))); ?></small></div><?php if ($entry['REVISION_ID']) { ?><small>À propos de la proposition #<?php echo intval($entry['REVISION_ID']); ?></small><?php } ?><p><?php echo nl2br($h($entry['BODY'])); ?></p><form method="post" action="<?php echo BDO_URL; ?>adminparabd/discussion" onsubmit="return confirm('Masquer ce commentaire ?');"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="discussion_id" value="<?php echo intval($entry['ID_DISCUSSION']); ?>"><button>Masquer ce commentaire</button></form><?php } ?>
            </article><?php } ?>
            <form class="parabd-discussion-form" method="post" action="<?php echo BDO_URL; ?>adminparabd/comment"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="revision_id" value=""><p class="parabd-comment-context" hidden>Commentaire lié à la proposition #<span></span> · <button type="button" class="parabd-clear-comment-context">retirer le lien</button></p><label>Ajouter un commentaire<textarea name="body" rows="4" maxlength="2000" required></textarea></label><button>Publier</button></form>
        </div></details>
    <?php } ?>
</div>
