<?php
$h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); };
$page = $view->getHelper('pagination');
$item = $view->item ?: array(); $posted = $_SERVER['REQUEST_METHOD'] === 'POST' ? $_POST : array();
$value = function ($name, $field = null, $default = '') use ($posted, $item) {
    if (array_key_exists($name, $posted) && !is_array($posted[$name])) return $posted[$name];
    $field = $field ?: strtoupper($name);
    return array_key_exists($field, $item) ? $item[$field] : $default;
};
$parents = array(); $children = array(); foreach ($view->types as $type) { if (!$type['PARENT_ID']) $parents[] = $type; else $children[$type['PARENT_ID']][] = $type; }
$typeCode = $value('type_code', 'TYPE_CODE'); $subtypeCode = $value('subtype_code', 'SUBTYPE_CODE');
$dateValue = $value('release_date', 'RELEASE_DATE');
if (!$posted && $dateValue) { if ($item['DATE_PRECISION'] === 'YEAR') $dateValue = substr($dateValue, 0, 4); elseif ($item['DATE_PRECISION'] === 'MONTH') $dateValue = substr($dateValue, 0, 7); }
$tri = function ($name, $field) use ($posted, $item, $h) {
    $current = array_key_exists($name, $posted) ? $posted[$name] : (array_key_exists($field, $item) && $item[$field] !== null ? (string) $item[$field] : 'unknown');
    $html = ''; foreach (array('unknown'=>'Inconnu','1'=>'Oui','0'=>'Non') as $code=>$label) $html .= '<option value="' . $h($code) . '"' . ((string) $current === (string) $code ? ' selected' : '') . '>' . $label . '</option>'; return $html;
};
$identifiers = isset($posted['identifiers']) && is_array($posted['identifiers']) ? $posted['identifiers'] : array_map(function ($row) { return array('scheme'=>$row['SCHEME'],'issuer'=>$row['ISSUER'],'value'=>$row['VALUE']); }, isset($item['identifiers']) ? $item['identifiers'] : array());
if (!$identifiers) $identifiers = array(array('scheme'=>'','issuer'=>'','value'=>''));
$authors = isset($posted['authors']) && is_array($posted['authors']) ? $posted['authors'] : array_map(function ($row) { return array('id'=>$row['AUTHOR_ID'],'label'=>$row['LABEL'],'role'=>$row['ROLE']); }, isset($item['authors']) ? $item['authors'] : array());
if (!$authors) $authors = array(array('id'=>'','label'=>'','role'=>'ARTIST'));
$series = isset($posted['series']) && is_array($posted['series']) ? $posted['series'] : array_map(function ($row) { return array('id'=>$row['SERIES_ID'],'label'=>$row['LABEL'],'relation_type'=>$row['RELATION_TYPE']); }, isset($item['series']) ? $item['series'] : array());
if (!$series) $series = array(array('id'=>'','label'=>'','relation_type'=>'RELATED'));
$tomes = isset($posted['tomes']) && is_array($posted['tomes']) ? $posted['tomes'] : array_map(function ($row) { return array('id'=>$row['TOME_ID'],'label'=>$row['LABEL'],'relation_type'=>$row['RELATION_TYPE']); }, isset($item['tomes']) ? $item['tomes'] : array());
if (!$tomes) $tomes = array(array('id'=>'','label'=>'','relation_type'=>'RELATED'));
$sources = isset($posted['sources']) && is_array($posted['sources']) ? $posted['sources'] : array_map(function ($row) { return array('url'=>$row['URL'],'label'=>$row['LABEL'],'notes'=>$row['NOTES']); }, isset($item['sources']) ? $item['sources'] : array());
if (!$sources) $sources = array(array('url'=>'','label'=>'','notes'=>''));
$readOnly = isset($item['STATUS']) && $item['STATUS'] === 'MERGED';
$showNewMediaForm = $view->mode === 'create' || !empty($posted['media_form_open']);
$mediaFormAttr = $view->mode === 'edit' ? ' form="parabd-admin-media-form"' : '';
$jsonPretty = function ($json) { $decoded = json_decode($json, true); return is_array($decoded) ? json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) : $json; };
$pendingStatusLabels = array('PENDING'=>'EN ATTENTE','CONFLICT'=>'INTERVENTION ADMIN');
$currentPatch = function ($revision) use ($item) {
    $before = json_decode($revision['PATCH_BEFORE'], true); $current = array();
    if (!is_array($before) || isset($before['_operation'])) return array('_etat' => 'Rattachement à vérifier sur la fiche');
    foreach ($before as $field => $unused) if (array_key_exists($field, $item)) $current[$field] = $item[$field];
    return $current;
};
$samePatch = function ($left, $right) {
    if (!is_array($left) || !is_array($right)) return false;
    foreach ($left as $field => $value) if (!array_key_exists($field, $right) || (($value === null || $value === '') ? !($right[$field] === null || $right[$field] === '') : (string) $value !== (string) $right[$field])) return false;
    return true;
};
