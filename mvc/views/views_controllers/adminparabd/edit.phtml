                <label>Sous-type<select name="subtype_code" id="parabd-admin-subtype"><option value="">Non précisé</option><?php foreach ($children as $parentId=>$types) foreach ($types as $type) { ?><option value="<?php echo $h($type['CODE']); ?>" data-parent="<?php echo intval($parentId); ?>"<?php if ($subtypeCode === $type['CODE']) echo ' selected'; ?>><?php echo $h($type['LABEL']); ?></option><?php } ?></select></label>
                <label class="wide">Titre *<input name="title" maxlength="255" required value="<?php echo $h($value('title', 'TITLE')); ?>"></label>
                <label>Statut<select name="status"><option value="ACTIVE"<?php if ($value('status', 'STATUS', 'ACTIVE') === 'ACTIVE') echo ' selected'; ?>>Active et visible</option><option value="HIDDEN"<?php if ($value('status', 'STATUS') === 'HIDDEN') echo ' selected'; ?>>Masquée</option></select></label>
                <label class="parabd-explicit-choice"><span><input type="checkbox" name="is_explicit" value="1"<?php if ((!$posted && !empty($item['IS_EXPLICIT'])) || (!empty($posted['is_explicit']))) echo ' checked'; ?>> Contenu explicite</span><small>Le visuel sera flouté selon les préférences du visiteur.</small></label>
