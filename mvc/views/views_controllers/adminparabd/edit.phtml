                <label>Largeur (mm)<input name="width_mm" inputmode="decimal" value="<?php echo $h($value('width_mm', 'WIDTH_MM')); ?>"></label><label>Hauteur (mm)<input name="height_mm" inputmode="decimal" value="<?php echo $h($value('height_mm', 'HEIGHT_MM')); ?>"></label>
                <label>Profondeur (mm)<input name="depth_mm" inputmode="decimal" value="<?php echo $h($value('depth_mm', 'DEPTH_MM')); ?>"></label><label>Poids (g)<input name="weight_g" inputmode="decimal" value="<?php echo $h($value('weight_g', 'WEIGHT_G')); ?>"></label>
