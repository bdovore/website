<?php
$h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); };
$page = $view->getHelper('pagination');
$grouped = array(); foreach ($view->queues['modifications'] as $row) $grouped[intval($row['ITEM_ID'])][] = $row;
$duplicateLevelLabels = array('CERTAIN'=>'Certain','STRONG'=>'Fort','POSSIBLE'=>'Possible');
?>
<div class="cadre1 parabd-page parabd-admin-page">
    <?php echo $page->menuAdmin(); ?>
    <nav class="parabd-admin-nav" aria-label="Administration Para-BD"><a href="<?php echo BDO_URL; ?>adminparabd">Fiches</a><a class="active" href="<?php echo BDO_URL; ?>adminparabd/queues">À traiter</a></nav>
    <h1>À traiter</h1>
    <p>Trois listes regroupent toutes les actions qui demandent une intervention administrative.</p>

    <section class="parabd-admin-section"><h2>Signalements (<?php echo count($view->queues['reports']); ?>)</h2>
        <?php if (!$view->queues['reports']) { ?><p>Aucun signalement ouvert.</p><?php } ?>
        <?php foreach ($view->queues['reports'] as $row) { ?><article class="parabd-admin-row"><div><strong><?php echo $h($row['TITLE'] ?: 'Fiche introuvable'); ?></strong><br><small><?php echo $h($row['REASON']); ?> · par <?php echo $h($row['REPORTER_NAME'] ?: 'un membre supprimé'); ?> · <?php echo $h(date('d/m/Y H:i', strtotime($row['CREATED_AT']))); ?></small></div><?php if ($row['ID_ITEM']) { ?><a class="button" href="<?php echo BDO_URL; ?>adminparabd/edit?id=<?php echo intval($row['ID_ITEM']); ?>&amp;report_id=<?php echo intval($row['ID_REPORT']); ?>">Ouvrir le signalement</a><?php } ?></article><?php } ?>
    </section>

    <section class="parabd-admin-section"><h2>Modifications (<?php echo count($view->queues['modifications']); ?>)</h2>
        <?php if (!$grouped) { ?><p>Aucune modification en attente.</p><?php } ?>
        <?php foreach ($grouped as $itemId => $rows) { ?><article class="parabd-admin-row"><div><strong><?php echo $h($rows[0]['TITLE']); ?></strong><br><small><?php echo count($rows); ?> demande(s)<?php $needsAdmin = array_filter($rows, function ($row) { return $row['STATUS'] === 'CONFLICT' || intval($row['CONTESTS']) > 0 || intval($row['CONFIRMS']) >= 2; }); if ($needsAdmin) echo ' · intervention admin requise'; ?></small></div><a class="button" href="<?php echo BDO_URL; ?>adminparabd/edit?id=<?php echo intval($itemId); ?>#modifications-a-valider">Examiner</a></article><?php } ?>
    </section>

    <section class="parabd-admin-section" id="doublons-potentiels"><h2>Doublons potentiels (<?php echo count($view->queues['duplicates']); ?>)</h2>
        <?php if (!$view->queues['duplicates']) { ?><p>Aucun doublon potentiel.</p><?php } ?>
        <?php foreach ($view->queues['duplicates'] as $row) { ?><article class="parabd-admin-row"><div><strong><?php echo $h($row['TITLE_LOW']); ?> / <?php echo $h($row['TITLE_HIGH']); ?></strong><br><small><?php echo $h(isset($duplicateLevelLabels[$row['LEVEL']]) ? $duplicateLevelLabels[$row['LEVEL']] : $row['LEVEL']); ?> · <?php echo $h($row['SCORE']); ?> %</small></div><div><a class="button" href="<?php echo BDO_URL; ?>adminparabd/merge?source_id=<?php echo intval($row['ITEM_ID_HIGH']); ?>&amp;target_id=<?php echo intval($row['ITEM_ID_LOW']); ?>">Comparer et fusionner</a><form class="inline" method="post" action="<?php echo BDO_URL; ?>adminparabd/duplicate"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="duplicate_id" value="<?php echo intval($row['ID_DUPLICATE']); ?>"><button name="decision" value="ignore">Ce ne sont pas des doublons</button></form></div></article><?php } ?>
    </section>
</div>
