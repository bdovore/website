            <th><a href="<?php echo $sortHref('status'); ?>">Statut <?php echo $sortMark('status'); ?></a></th>
            <th><a href="<?php echo $sortHref('copies'); ?>">Exemplaires <?php echo $sortMark('copies'); ?></a></th>
            <th><a href="<?php echo $sortHref('history'); ?>">Historique <?php echo $sortMark('history'); ?></a></th>
            <th><a href="<?php echo $sortHref('updated'); ?>">Dernière modification <?php echo $sortMark('updated'); ?></a></th>
