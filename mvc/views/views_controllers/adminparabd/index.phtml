            <td><span class="parabd-status parabd-status-<?php echo strtolower($item['STATUS']); ?>"><?php echo $h(isset($statusLabels[$item['STATUS']]) ? $statusLabels[$item['STATUS']] : $item['STATUS']); ?></span><?php if ($item['STATUS'] === 'MERGED') { ?><br><small>vers #<?php echo intval($item['MERGED_INTO_ID']); ?></small><?php } ?></td>
            <td><?php echo intval($item['COPY_COUNT']); ?></td><td><?php echo intval($item['HISTORY_COUNT']); ?></td>
