<?php
$h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); };
$page = $view->getHelper('pagination');
$statusLabels = array('ACTIVE' => 'Active', 'HIDDEN' => 'Masquée', 'MERGED' => 'Fusionnée');

$baseParams = array('q' => $view->search, 'status' => $view->status, 'per_page' => $view->per_page, 'sort' => $view->sort, 'dir' => $view->dir, 'page' => $view->page);
$url = function (array $override = array()) use ($baseParams) {
    $params = array_merge($baseParams, $override);
    $params = array_filter($params, function ($v, $k) {
        if ($k === 'page' || $k === 'per_page') return intval($v) > 0;
        return $v !== '' && $v !== null;
    }, ARRAY_FILTER_USE_BOTH);
    if (!empty($params['page']) && intval($params['page']) === 1) unset($params['page']);
    $qs = http_build_query($params);
    return BDO_URL . 'adminparabd' . ($qs ? '?' . $qs : '');
};
$sortHref = function ($col) use ($url, $view) {
    $defaultDir = ($col === 'title') ? 'ASC' : 'DESC';
    $dir = ($view->sort === $col) ? ($view->dir === 'ASC' ? 'DESC' : 'ASC') : $defaultDir;
    return $url(array('sort' => $col, 'dir' => $dir, 'page' => 1));
};
$sortMark = function ($col) use ($view) {
    if ($view->sort !== $col) return '<span class="fa fa-sort" aria-hidden="true"></span>';
    return $view->dir === 'ASC' ? '<span class="fa fa-caret-up" aria-hidden="true"></span>' : '<span class="fa fa-caret-down" aria-hidden="true"></span>';
};
$paginationBar = function () use ($view, $url) {
    if ($view->total_pages <= 1) return '';
    $html = '<div class="pagination parabd-admin-pagination">';
    $html .= ($view->page > 1) ? '<a href="' . $url(array('page' => $view->page - 1)) . '">◄</a>' : '<span class="inactive">◄</span>';
    for ($i = 1; $i <= $view->total_pages; $i++) {
        $html .= ($i == $view->page) ? '<span class="active">' . $i . '</span>' : '<a href="' . $url(array('page' => $i)) . '">' . $i . '</a>';
    }
    $html .= ($view->page < $view->total_pages) ? '<a href="' . $url(array('page' => $view->page + 1)) . '">►</a>' : '<span class="inactive">►</span>';
    return $html . '</div>';
};
?>
