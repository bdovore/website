<?php
$ficheAlbum = $view->getHelper('ficheAlbum');
$rubrique = $view->rubriques[$view->mode];
[$action, , $titre, $description] = $rubrique;
$rayon = $view->rayons[$view->origine];
$nombreGenres = count($view->genresRetenus);
$groupes = ['À suivre' => [3, 4, 5, 6], 'Classements' => [7, 1, 2]];
$urlGuide = static function (string $action, int $origine, array $genres = [], int $page = 1): string {
    $parametres = ['origine' => $origine];
    if ($genres) {
        $parametres['a_idGenre'] = $genres;
    }
    if ($page > 1) {
        $parametres['page'] = $page;
    }
    $url = BDO_URL . 'leguide/' . $action . '?' . http_build_query($parametres);
    return htmlspecialchars($url, ENT_QUOTES, 'UTF-8');
};
?>
<div class="bdo-guide">
    <h1>Le Guide BD</h1>
    <nav class="bdo-guide-rayons" aria-label="Rayons du Guide BD">
        <p>Rayon</p>
        <div class="bdo-guide-links">
            <?php foreach ($view->rayons as $idRayon => $nom) { ?>
                <a href="<?php echo $urlGuide($action, $idRayon, $view->origine === $idRayon ? $view->genresRetenus : []); ?>"<?php if ($view->origine === $idRayon) { ?> aria-current="true"<?php } ?>><?php echo $nom; ?></a>
            <?php } ?>
        </div>
    </nav>
    <nav class="bdo-guide-sections" aria-label="Rubriques du Guide BD">
        <?php foreach ($groupes as $groupe => $modes) { ?>
            <div>
                <p><?php echo $groupe; ?></p>
                <div class="bdo-guide-links">
                    <?php foreach ($modes as $mode) {
                        [$lien, $libelle] = $view->rubriques[$mode];
                        ?>
                        <a href="<?php echo $urlGuide($lien, $view->origine, $view->genresRetenus); ?>"<?php if ($view->mode === $mode) { ?> aria-current="page"<?php } ?>><?php echo $libelle; ?></a>
                    <?php } ?>
                </div>
            </div>
        <?php } ?>
    </nav>

    <div class="bdo-guide-filters">
        <details class="bdo-guide-genres">
            <summary>Genres<?php if ($nombreGenres) { ?> (<?php echo $nombreGenres; ?>)<?php } ?></summary>
            <form action="<?php echo BDO_URL . 'leguide/' . $action; ?>" method="get" class="bdo-guide-genre-form">
                <input type="hidden" name="origine" value="<?php echo $view->origine; ?>">
                <input type="search" class="bdo-guide-genre-search" aria-label="Rechercher un genre" placeholder="Rechercher un genre…" hidden>
                <fieldset class="bdo-guide-genre-choices" aria-label="Genres du rayon <?php echo $rayon; ?>">
                    <?php foreach ($view->genres as $genre) { ?>
                        <label>
                            <input type="checkbox" name="a_idGenre[]" value="<?php echo (int) $genre->ID_GENRE; ?>"<?php if (in_array((int) $genre->ID_GENRE, $view->genresRetenus, true)) { ?> checked<?php } ?>>
                            <?php echo htmlspecialchars($genre->LIBELLE, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>
                        </label>
                    <?php } ?>
                </fieldset>
                <p class="bdo-guide-no-genre" hidden>Aucun genre trouvé.</p>
                <p class="bdo-guide-genre-limit" hidden role="status">Dix genres sélectionnés au maximum.</p>
                <button type="submit" class="bdo-guide-apply">Appliquer</button>
            </form>
        </details>
        <?php if ($nombreGenres) { ?>
            <a href="<?php echo $urlGuide($action, $view->origine); ?>">Effacer les filtres</a>
        <?php } ?>
    </div>

    <section aria-labelledby="bdo-guide-rubrique">
        <div class="bdo-guide-band">
            <h2 id="bdo-guide-rubrique"><?php echo $titre; ?></h2>
            <span><?php echo $rayon; ?></span>
        </div>
        <p class="bdo-guide-description"><?php echo $description; ?></p>
        <?php if (!$view->resultats) { ?>
            <p>Aucun résultat<?php echo $nombreGenres ? ' pour les genres sélectionnés' : ' dans ce rayon'; ?>.</p>
        <?php } else { ?>
            <ul class="bdo-album-list">
                <?php if ($view->mode === 3) {
                    $texte = $view->getHelper('texte');
                    $avisDansGuide = true;
                    $peutModerer = User::minAccesslevel(1);
                    foreach ($view->resultats as $avis) {
                        require __DIR__ . '/../_partials/avis-album.phtml';
                    }
                } else {
                    foreach ($view->resultats as $album) { ?>
                        <li><?php echo $view->mode === 2 ? $ficheAlbum->serie($album, 'big') : $ficheAlbum->big($album, false); ?></li>
                    <?php }
                } ?>
            </ul>
        <?php } ?>
        <?php if ($view->page > 1 || ($view->page < 20 && count($view->resultats) === 20)) { ?>
            <nav class="bdo-guide-pagination" aria-label="Pages des résultats">
                <?php if ($view->page > 1) { ?>
                    <a rel="prev" href="<?php echo $urlGuide($action, $view->origine, $view->genresRetenus, $view->page - 1); ?>">← Précédent</a>
                <?php } ?>
                <span>Page <?php echo $view->page; ?></span>
                <?php if ($view->page < 20 && count($view->resultats) === 20) { ?>
                    <a rel="next" href="<?php echo $urlGuide($action, $view->origine, $view->genresRetenus, $view->page + 1); ?>">Suivant →</a>
                <?php } ?>
            </nav>
        <?php } ?>
    </section>
</div>
<script src="<?php echo BDO_URL; ?>script/leguide.js?v=20261118a" defer></script>
