<?php
$h = static fn($s) => htmlspecialchars((string)$s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$edit = ['ser'=>'editserie?serie_id=', 'alb'=>'editalbum?alb_id=', 'aut'=>'editauteur?auteur_id=',
    'edit'=>'editediteur?editeur_id=', 'col'=>'editcollection?collec_id='];
$names = BrowserCatalogue::TYPES + ['col'=>'Collections'];
$hasResults = false;
if ($view->approximate) { ?><p>Résultats proches de votre recherche</p><?php }
foreach ($view->groups as $kind => $group) {
    if (!$group['rows']) continue;
    $hasResults = true;
    if ($view->type === 'all') { ?><section><h2><?= $names[$kind] ?></h2><?php }
    foreach ($group['rows'] as $row) {
        $id = (int)$row['id'];
        $name = $row['label'] ?: 'Sans titre';
        $cover = BDO_URL_COUV . ($row['cover'] ?? 'default.png');
        $editUrl = BDO_URL . 'admin/' . $edit[$kind] . $id;
        if ($kind === 'alb') {
            $albumUrl = $h(BDO_URL . 'album?id_tome=' . $id . (isset($row['edition']) ? '&id_edition=' . (int)$row['edition'] : '') . ($view->mobile ? '&mobile=T' : ''));
            $albumClass = $view->mobile ? '' : 'fancybox fancybox.iframe {width:600,height:600}';
            ?>
            <div class="browser-album">
                <a class="<?= $albumClass ?>" href="<?= $albumUrl ?>" aria-label="<?= $h($name) ?>">
                    <img loading="lazy" src="<?= $h($cover) ?>" alt="">
                </a>
                <div>
                    <small><?= $h($row['subtitle'] ?? '') ?><?= isset($row['number']) ? ' · T. ' . (int)$row['number'] : '' ?></small>
                    <strong><a class="<?= $albumClass ?>" href="<?= $albumUrl ?>"><?= $h($name) ?></a></strong>
                    <?php if ($view->canEdit && $id) { ?><a href="<?= $h($editUrl) ?>" title="Modifier <?= $h($name) ?>"><img src="<?= $h(BDO_URL_IMAGE . 'edit.gif') ?>" width="18" height="13" alt="Modifier <?= $h($name) ?>"></a><?php } ?>
                </div>
            </div>
        <?php } else { ?>
            <details class="browser-node" data-kind="<?= $kind ?>" data-id="<?= $id ?>"
                <?php if ($kind === 'col') { ?>data-publisher="<?= (int)$view->id ?>"<?php } ?>>
                <summary><?php if ($kind === 'ser') { ?><img src="<?= $h($cover) ?>" loading="lazy" alt=""><?php } ?>
                    <span><strong><?= $h($name) ?></strong><?php if (!empty($row['subtitle'])) { ?><small><?= $h($row['subtitle']) ?></small><?php } ?></span>
                </summary>
                <div class="browser-branch">
                    <?php if ($kind === 'ser' || $kind === 'aut') { ?>
                        <a href="<?= $h(BDO_URL . ($kind === 'ser' ? 'serie-bd-' : 'auteur-bd-') . $id . '-' . clean_url($name)) ?>">Voir la fiche <?= $kind === 'ser' ? 'série' : 'auteur' ?></a>
                    <?php } ?>
                    <?php if ($view->canEdit && $id) { ?><a href="<?= $h($editUrl) ?>" title="Modifier <?= $h($name) ?>"><img src="<?= $h(BDO_URL_IMAGE . 'edit.gif') ?>" width="18" height="13" alt="Modifier <?= $h($name) ?>"></a><?php } ?>
                    <?php if ($kind === 'ser') { ?><div class="browser-arrows" aria-label="Défilement des albums">
                        <button type="button" aria-label="Faire défiler les albums vers la gauche" data-scroll="-1">‹</button>
                        <button type="button" aria-label="Faire défiler les albums vers la droite" data-scroll="1">›</button>
                    </div><?php } ?>
                    <div class="browser-children <?= $kind === 'ser' ? 'browser-rail' : '' ?>"></div>
                </div>
            </details>
        <?php }
    }
    if ($group['more']) { ?>
        <button class="browser-more" type="button" data-type="<?= $kind ?>" data-offset="<?= $view->offset + $view->size ?>">Afficher plus · <?= $h($names[$kind]) ?></button>
    <?php }
    if ($view->type === 'all') { ?></section><?php }
}
if (!$hasResults) { ?><p>Aucun résultat. <?php if (!$view->parent) { ?><a href="<?= $h(BDO_URL . 'proposition') ?>">Proposer un album</a><?php } ?></p><?php }
