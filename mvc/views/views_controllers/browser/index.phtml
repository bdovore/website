<?php $h = static fn($s) => htmlspecialchars((string)$s, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>
<main class="bdo-browser" data-endpoint="<?= $h(BDO_URL . 'browser/results') ?>">
    <h1>Explorer le catalogue</h1>
    <form class="browser-search" method="get" action="<?= $h(BDO_URL . 'browser') ?>">
        <label for="browser-query">Rechercher dans le catalogue</label>
        <div><input id="browser-query" name="q" type="search" maxlength="120" value="<?= $h($view->query) ?>"
            placeholder="Album, série, auteur, éditeur…"><button>Rechercher</button></div>
        <fieldset class="browser-scope" hidden>
            <legend>Rechercher parmi</legend>
            <div><?php foreach (['all' => 'Tout'] + $view->types as $key => $label) { ?>
                <label><input type="radio" name="scope" value="<?= $key ?>"> <?= $label ?></label>
            <?php } ?></div>
        </fieldset>
    </form>
    <div class="browser-explore">
        <form class="browser-filters" method="get" action="<?= $h(BDO_URL . 'browser') ?>">
            <input type="hidden" name="rb_browse" value="<?= $h($view->type) ?>">
            <label>Rayon <select name="origine"><option value="">Tous les rayons</option>
                <?php foreach ($view->rayons as $id => $label) { ?>
                    <option value="<?= $id ?>" <?= $view->origine === $id ? 'selected' : '' ?>><?= $label ?></option>
                <?php } ?>
            </select></label>
            <details class="browser-genres"><summary>Genres<?= $view->selected ? ' (' . count($view->selected) . ')' : '' ?></summary>
                <input type="search" aria-label="Rechercher un genre" placeholder="Rechercher un genre…">
                <div><?php foreach ($view->choices as $genre) { ?>
                    <label><input type="checkbox" name="a_idGenre[]" value="<?= (int)$genre->ID_GENRE ?>"
                        <?= in_array((int)$genre->ID_GENRE, $view->selected, true) ? 'checked' : '' ?>> <?= $h($genre->LIBELLE) ?></label>
                <?php } ?></div>
                <button>Appliquer les genres</button>
                <small class="browser-limit" role="status" hidden>Dix genres sélectionnés au maximum.</small>
            </details>
        </form>
        <?php if ($view->selected) { ?>
            <div class="browser-chips" aria-label="Genres actifs">
            <?php foreach ($view->choices as $genre) {
                $id = (int)$genre->ID_GENRE;
                if (!in_array($id, $view->selected, true)) continue;
                $remaining = array_values(array_diff($view->selected, [$id]));
                $params = ['origine'=>$view->origine, 'rb_browse'=>$view->type, 'a_idGenre'=>$remaining];
                ?>
                <a href="<?= $h(BDO_URL . 'browser?' . http_build_query($params)) ?>" aria-label="<?= $h('Retirer ' . $genre->LIBELLE) ?>"><?= $h($genre->LIBELLE) ?> ×</a>
            <?php } ?>
            </div>
        <?php } ?>
        <nav class="browser-types" aria-label="Parcourir le catalogue">
            <?php foreach ($view->types as $key => $label) { ?>
                <button type="button" data-type="<?= $key ?>" aria-pressed="<?= $view->type === $key ? 'true' : 'false' ?>"><?= $label ?></button>
            <?php } ?>
        </nav>
        <div class="browser-list"></div>
    </div>
    <div class="browser-matches" hidden></div>
    <noscript>Activez JavaScript pour parcourir les branches du catalogue.</noscript>
</main>
<script src="<?= $h(BDO_URL . 'script/browser.js') ?>" defer></script>
