                <form class="parabd-file-form" action="<?php echo BDO_URL; ?>parabd/media" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>">
                    <label>Depuis mon appareil <input type="file" name="visual" accept="image/jpeg,image/png,image/webp"></label>
