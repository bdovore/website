<?php
$h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); };
$formatRevision = function ($json) {
    $patch = json_decode($json, true);
    if (!is_array($patch)) return 'Détail de la modification indisponible.';
    $labels = array('TITLE'=>'Titre','DESCRIPTION'=>'Description','MATERIAL'=>'Matière','COLOR'=>'Couleur','MANUFACTURER'=>'Fabricant','PUBLISHER'=>'Éditeur','RELEASE_DATE'=>'Date','DELETE_AUTHOR'=>'Retrait de l’auteur','DELETE_SERIES'=>'Retrait de la série','DELETE_TOME'=>'Retrait de l’album');
    if (isset($patch['_operation'])) return (isset($labels[$patch['_operation']]) ? $labels[$patch['_operation']] : 'Modification d’un rattachement') . ' #' . intval($patch['_id']);
    $parts = array();
    foreach ($patch as $field => $value) {
        if (substr($field, -11) === '_NORMALIZED' || $field === 'DATE_PRECISION') continue;
        $display = ($value === null || $value === '') ? 'non renseigné' : (is_scalar($value) ? (string) $value : 'valeur structurée');
        $parts[] = (isset($labels[$field]) ? $labels[$field] : $field) . ' : ' . $display;
    }
    return $parts ? implode(' · ', $parts) : 'Modification technique de la fiche.';
};
$item = $view->item;
$itemCopies = array_filter($view->copies, function ($copy) use ($item) { return intval($copy['ITEM_ID']) === intval($item['ID_ITEM']); });
$ownedCopies = array_filter($itemCopies, function ($copy) { return $copy['STATE'] === 'OWNED'; });
$wishlistCopies = array_filter($itemCopies, function ($copy) { return $copy['STATE'] === 'WISHLIST'; });
$wishlistCopy = $wishlistCopies ? reset($wishlistCopies) : null;
$conditions = array('UNKNOWN'=>'Non renseigné','MINT'=>'Neuf','NEAR_MINT'=>'Comme neuf','VERY_GOOD'=>'Très bon','GOOD'=>'Bon','FAIR'=>'Correct','POOR'=>'Usé');
$triOptions = function ($current) {
    $options = array(''=>'Inconnu','1'=>'Oui','0'=>'Non');
    $html = '';
    foreach ($options as $value => $label) $html .= '<option value="' . $value . '"' . ((string) $current === (string) $value ? ' selected' : '') . '>' . $label . '</option>';
    return $html;
};
