                    <select name="media_type"><option value="GALLERY">Galerie</option><option value="DETAIL">Détail</option><option value="BOX">Boîte</option><option value="CERTIFICATE">Certificat</option></select>
                    <label class="parabd-media-explicit-option"><input type="checkbox" name="is_explicit" value="1"> Contenu explicite <small>si ce visuel comporte un contenu sexuel ou érotique explicite</small></label>
                    <?php if (!$view->charter_accepted) { ?><label><input type="checkbox" name="accept_charter" value="1" required> J’accepte la <a href="<?php echo BDO_URL; ?>parabd/charte" target="_blank" rel="noopener">charte de contribution</a>, version <?php echo $h($view->charter_version); ?>.</label><?php } ?>
                    <button type="submit">Envoyer</button> <span class="parabd-form-status"></span>
