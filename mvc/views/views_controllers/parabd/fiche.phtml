                <?php if ($item['authors']) { ?><h2>Retirer un artiste</h2><ul class="parabd-relation-actions">
                    <?php foreach ($item['authors'] as $link) { ?><li>#<?php echo intval($link['AUTHOR_ID']); ?> — <?php echo $h($link['LABEL']); ?> <form class="inline parabd-json-form" action="<?php echo BDO_URL; ?>parabd/contribute" method="post"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="base_revision_no" value="<?php echo intval($item['REVISION_NO']); ?>"><input type="hidden" name="field" value="DELETE_AUTHOR"><input type="hidden" name="value" value="<?php echo intval($link['AUTHOR_ID']); ?>"><button type="submit">Proposer le retrait</button><span class="parabd-form-status"></span></form></li><?php } ?>
                </ul><?php } ?>
                <?php if ($item['series'] || $item['tomes']) { ?><h2>Retirer un rattachement BD</h2><ul class="parabd-relation-actions">
                    <?php foreach ($item['series'] as $link) { ?><li>#<?php echo intval($link['SERIES_ID']); ?> — <?php echo $h($link['LABEL']); ?> <form class="inline parabd-json-form" action="<?php echo BDO_URL; ?>parabd/contribute" method="post"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="base_revision_no" value="<?php echo intval($item['REVISION_NO']); ?>"><input type="hidden" name="field" value="DELETE_SERIES"><input type="hidden" name="value" value="<?php echo intval($link['SERIES_ID']); ?>"><button type="submit">Proposer le retrait</button><span class="parabd-form-status"></span></form></li><?php } ?>
                    <?php foreach ($item['tomes'] as $link) { ?><li>#<?php echo intval($link['TOME_ID']); ?> — <?php echo $h($link['LABEL']); ?> <form class="inline parabd-json-form" action="<?php echo BDO_URL; ?>parabd/contribute" method="post"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="base_revision_no" value="<?php echo intval($item['REVISION_NO']); ?>"><input type="hidden" name="field" value="DELETE_TOME"><input type="hidden" name="value" value="<?php echo intval($link['TOME_ID']); ?>"><button type="submit">Proposer le retrait</button><span class="parabd-form-status"></span></form></li><?php } ?>
                </ul><?php } ?>

                <h2>Signaler un problème</h2>
                <form class="parabd-json-form" action="<?php echo BDO_URL; ?>parabd/report" method="post">
                    <input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="target_type" value="ITEM"><input type="hidden" name="target_id" value="<?php echo intval($item['ID_ITEM']); ?>">
                    <label>Motif <input name="reason" style="width: 220px;" required placeholder="Doublon, erreur, image…"></label><label>Détails <input name="details" style="width: 220px;"></label><button type="submit">Signaler</button> <span class="parabd-form-status"></span>
                </form>
            </div>
        </details>
    <?php } else { ?>
        <p class="parabd-login-note">Connectez-vous pour ajouter cet objet à votre collection ou proposer une modification.</p>
    <?php } ?>

    <?php if ($view->can_contribute) { ?><details class="parabd-discussion" id="discussion"><summary><strong>Discussion (<?php echo intval($view->discussion['comment_count']); ?> commentaire(s))</strong><span class="fas parabd-discussion-chevron" aria-hidden="true"></span></summary><div class="parabd-discussion-content">
        <?php if (!$view->discussion['entries']) { ?><p>Aucun échange pour le moment.</p><?php } ?>
        <?php foreach ($view->discussion['entries'] as $entry) { ?><article class="parabd-discussion-entry"<?php if ($entry['REVISION_ID']) { ?> data-revision-id="<?php echo intval($entry['REVISION_ID']); ?>"<?php } ?>>
            <?php if ($entry['MESSAGE_TYPE'] === 'PROPOSAL') { ?><div class="parabd-history-summary"><strong><?php echo $h($entry['AUTHOR_NAME'] ?: 'Un membre supprimé'); ?> a proposé une modification</strong><span class="parabd-status parabd-status-<?php echo strtolower($entry['REVISION_STATUS']); ?>"><?php echo $h($entry['REVISION_STATUS'] === 'APPLIED' ? 'APPLIQUÉE AUTOMATIQUEMENT' : $entry['REVISION_STATUS']); ?></span></div><p><small><?php echo $h($formatRevision($entry['PATCH_BEFORE'])); ?> → <?php echo $h($formatRevision($entry['PATCH_AFTER'])); ?></small></p><p><?php if ($entry['REVISION_STATUS'] !== 'APPLIED') { ?><?php echo intval($entry['CONFIRMS']); ?>/2 confirmation(s)<?php if ($entry['CONTESTS']) echo ' · ' . intval($entry['CONTESTS']) . ' opposition(s)'; ?> · <?php } ?><button type="button" class="parabd-comment-revision" data-revision-id="<?php echo intval($entry['REVISION_ID']); ?>">Commenter</button></p>
                <?php if (intval($entry['AUTHOR_ID']) !== intval($view->user_id) && in_array($entry['REVISION_STATUS'], array('PENDING','CONFLICT'), true)) { ?><form class="parabd-json-form parabd-vote-form" action="<?php echo BDO_URL; ?>parabd/vote" method="post"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="revision_id" value="<?php echo intval($entry['REVISION_ID']); ?>"><label>Motif de l’opposition<textarea name="reason" rows="2" maxlength="2000" placeholder="Obligatoire uniquement pour s’opposer"></textarea></label><button name="vote" value="CONFIRM">Confirmer</button><button name="vote" value="CONTEST">S’opposer</button><span class="parabd-form-status"></span></form><?php } ?>
            <?php } else { ?><div class="parabd-history-summary"><strong><?php echo $h($entry['AUTHOR_NAME'] ?: 'Membre supprimé'); ?></strong><small><?php echo $h(date('d/m/Y H:i', strtotime($entry['CREATED_AT']))); ?></small></div><?php if ($entry['REVISION_ID']) { ?><small>À propos de la proposition #<?php echo intval($entry['REVISION_ID']); ?></small><?php } ?><p><?php echo nl2br($h($entry['BODY'])); ?></p><?php } ?>
        </article><?php } ?>
        <form class="parabd-json-form parabd-discussion-form" method="post" action="<?php echo BDO_URL; ?>parabd/comment"><input type="hidden" name="csrf_token" value="<?php echo $h($view->csrf_token); ?>"><input type="hidden" name="item_id" value="<?php echo intval($item['ID_ITEM']); ?>"><input type="hidden" name="revision_id" value=""><p class="parabd-comment-context" hidden>Commentaire lié à la proposition #<span></span> · <button type="button" class="parabd-clear-comment-context">retirer le lien</button></p><label>Ajouter un commentaire<textarea name="body" rows="4" maxlength="2000" required></textarea></label><button>Publier</button><span class="parabd-form-status"></span></form>
    </div></details><?php } ?>
