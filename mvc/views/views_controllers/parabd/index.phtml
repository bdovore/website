<?php $h = function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); }; ?>
<div class="cadre1 parabd-page">
    <div class="parabd-heading">
        <div><h1>Catalogue Para-BD</h1><p>Objets partagés par les collectionneurs.</p></div>
        <a class="button" href="<?php echo BDO_URL; ?>parabd/create">Créer un objet</a>
    </div>
    <form method="get" action="<?php echo BDO_URL; ?>parabd" class="parabd-search">
        <label for="parabd-q">Rechercher</label>
        <input id="parabd-q" name="q" value="<?php echo $h($view->search); ?>" placeholder="Titre, personnage, fabricant…">
        <button type="submit">Rechercher</button>
    </form>
    <div class="parabd-grid">
        <?php foreach ($view->items as $item) { ?>
            <article class="parabd-card">
                <?php if ($item['PRIMARY_IMAGE']) { ?><img src="<?php echo $h(BDO_URL_PARABD . $item['PRIMARY_IMAGE']); ?>" alt=""><?php } ?>
                <div><small><?php echo $h($item['SUBTYPE_LABEL'] ?: $item['TYPE_LABEL']); ?></small>
                    <h2><a href="<?php echo BDO_URL; ?>parabd/fiche?id=<?php echo intval($item['ID_ITEM']); ?>"><?php echo $h($item['TITLE']); ?></a></h2>
                    <?php if ($item['MANUFACTURER']) { ?><p><?php echo $h($item['MANUFACTURER']); ?></p><?php } ?>
                </div>
            </article>
        <?php } ?>
    </div>
    <?php if (!$view->items) { ?><p>Aucun objet ne correspond à cette recherche.</p><?php } ?>
</div>
