<li class="bdo-album-preview" itemscope itemtype="http://schema.org/Book">
    <div class="bdo-album-cover">
        <?php echo $ficheAlbum->urlAlbum($album, 'couvBig', false, $estSortie); ?>
    </div>
    <div class="bdo-album-preview-text">
        <?php echo $ficheAlbum->getTitreTome($album); ?>
        <?php $auteursAlbum = $ficheAlbum->auteurs($album); ?>
        <?php if ($auteursAlbum !== '') { ?>
            <p class="bdo-home-meta"><?php echo $auteursAlbum; ?></p>
        <?php } ?>
        <?php if ($estSortie) { ?>
            <?php if ($album->NOM_SERIE && strcasecmp($album->NOM_SERIE, $album->TITRE_TOME) !== 0) { ?>
                <p class="bdo-home-meta"><?php echo $ficheAlbum->urlSerie($album); ?></p>
            <?php } ?>
            <?php if ($album->NOM_GENRE || $album->NOM_EDITEUR) { ?>
                <p class="bdo-home-meta">
                    <?php if ($album->NOM_GENRE) { ?>
                        <span itemprop="genre"><?php echo htmlspecialchars($album->NOM_GENRE, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?></span>
                    <?php } ?>
                    <?php if ($album->NOM_EDITEUR) { ?>
                        <?php if ($album->NOM_GENRE) { ?> · <?php } ?>
                        <span itemprop="publisher"><?php echo htmlspecialchars($album->NOM_EDITEUR, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?></span>
                        <?php if ($album->NOM_COLLECTION && $album->NOM_COLLECTION !== '<N/A>') { ?>
                            · <?php echo htmlspecialchars($album->NOM_COLLECTION, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>
                        <?php } ?>
                        <?php if (!empty($album->DATE_PARUTION_EDITION)) { ?>
                            (<?php echo $ficheAlbum->dateParution($album->DATE_PARUTION_EDITION); ?>)
                        <?php } ?>
                    <?php } ?>
                </p>
            <?php } ?>
            <?php if ($album->NB_NOTE_TOME > 0) { ?>
                <p class="bdo-home-meta bdo-home-score"><span aria-hidden="true">★</span> <?php echo str_replace('.', ',', (string) ($album->MOYENNE_NOTE_TOME / 2)); ?>/5</p>
            <?php } ?>
            <?php if (Bdo_Cfg::user()->minAccesslevel(2)) {
                echo $ficheAlbum->linkCollection($album);
            } ?>
        <?php } ?>
    </div>
</li>
