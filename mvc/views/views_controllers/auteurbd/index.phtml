<style>
    /* Style pour le bouton de tri discret */
    #tri-toggle {
        font-family: Arial, sans-serif;
    }
    #tri-toggle:hover {
        background-color: #c00000;
    }
    
    /* Style pour le menu de tri */
    #tri-menu {
        font-family: Arial, sans-serif;
        font-size: 13px;
    }
    #tri-menu div:hover {
        background-color: #f5f5f5;
    }
    
    /* Style pour le bouton de tri actif */
    #tri-toggle.active {
        background-color: #c00000;
    }
</style>

<script>
    $(document).ready(function() {
        $("#select_activite").buttonset();
        
        // Fermer le menu si clic en dehors
        $(document).click(function(e) {
            if (!$(e.target).closest('#tri-toggle').length && !$(e.target).closest('#tri-menu').length) {
                $('#tri-menu').hide();
                $('#tri-toggle').removeClass('active');
            }
        });
    });
    
    // Fonction pour afficher/masquer le menu de tri
    function toggleTriMenu() {
        var menu = $('#tri-menu');
        var toggle = $('#tri-toggle');
        
        if (menu.is(':visible')) {
            menu.hide();
            toggle.removeClass('active');
        } else {
            menu.show();
            toggle.addClass('active');
        }
        
        // Empêcher la propagation du clic
        event.stopPropagation();
    }
    
    // Fonction pour définir le tri et soumettre le formulaire
    function setTri(value) {
        $('input[name="tri"]').val([value]);
        $('#form1').submit();
    }
    
    // affichage des infos de bio : on affiche le début et un bouton "voir plus"
        if ($("#bioauteur").height() > 120) {
             $("#bioauteur").addClass("textmasked");
             $("#more").show();
            $("#less").hide();
        } else {
            $("#more").hide();
            $("#less").hide();
        }
    function moreBio () {
        $("#bioauteur").removeClass("textmasked");
         $("#more").hide();
         $("#less").show();
    }
    
    function lessBio () {
        $("#bioauteur").addClass("textmasked");
         $("#more").show();
         $("#less").hide();
    }
</script>